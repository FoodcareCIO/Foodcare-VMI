# Supabase project URL (same project the Expo app + backend use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key - safe to expose to the browser, used for admin sign-in
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Secret (service-role) key - SERVER ONLY, bypasses RLS. Never prefix with NEXT_PUBLIC.
# Matches SUPABASE_SECRET_KEY used by the backend service.
SUPABASE_SECRET_KEY=your-secret-service-role-key
